#
# Hardened Percona Proxy for MariaDB image, built on Debian.
#
# Compared with the UBI9 image it keeps only what Percona Proxy needs at runtime: recommended
# packages are not installed, the package manager caches, documentation and manual pages are
# removed, and no file keeps its setuid or setgid bit.
#
# Removing the setuid bits disables PAM authentication, which needs a setuid
# percona-proxy-pam-auth-tool. Use the UBI9 image when the PAM authenticator is required.
#
FROM debian:12-slim

# Please don't remove old-style LABEL since it's needed for RedHat certification
LABEL name="Percona Proxy for MariaDB" \
      vendor="Percona" \
      summary="Database proxy for MariaDB and MySQL, hardened image" \
      description="Percona Proxy for MariaDB is a database proxy that forwards database statements to one or more servers, using complex rules, a semantic understanding of the statements and the roles of the servers in the backend cluster. This image is built on Debian and carries only what Percona Proxy needs at runtime." \
      maintainer="Percona Development <info@percona.com>"

LABEL org.opencontainers.image.title="Percona Proxy for MariaDB (hardened)"
LABEL org.opencontainers.image.vendor="Percona"
LABEL org.opencontainers.image.description="Percona Proxy for MariaDB is a database proxy that forwards \
database statements to one or more servers. This image is built on Debian and carries only what \
Percona Proxy needs at runtime."
LABEL org.opencontainers.image.license="GPL-2.0-or-later"
LABEL org.opencontainers.image.authors="info@percona.com"

ARG PERCONA_PROXY_VERSION=1.0.0
ARG PERCONA_PROXY_RELEASE=1
ARG REPO_COMPONENT=experimental

ENV PERCONA_PROXY_VERSION=${PERCONA_PROXY_VERSION}
LABEL org.label-schema.schema-version=${PERCONA_PROXY_VERSION}
LABEL org.opencontainers.image.version=${PERCONA_PROXY_VERSION}

RUN set -ex; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg2 procps; \
    \
    # The repository package is verified against the Percona packaging key before it is used.
    export GNUPGHOME="$(mktemp -d)"; \
    curl -fsSL -o /tmp/percona-release.deb https://repo.percona.com/apt/percona-release_latest.generic_all.deb; \
    curl -fsSL https://repo.percona.com/apt/percona-keyring.gpg -o /tmp/percona-keyring.gpg || true; \
    apt-get install -y --no-install-recommends /tmp/percona-release.deb; \
    rm -rf "$GNUPGHOME" /tmp/percona-release.deb /tmp/percona-keyring.gpg; \
    \
    percona-release enable percona-proxy ${REPO_COMPONENT}; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        percona-proxy-mariadb=${PERCONA_PROXY_VERSION}-${PERCONA_PROXY_RELEASE}.bookworm; \
    \
    # The licenses are collected before the documentation is pruned.
    mkdir -p /licenses; \
    cp /usr/share/percona-proxy/LICENSE.TXT /licenses/LICENSE.percona-proxy; \
    cp /usr/share/doc/percona-proxy-mariadb/copyright /licenses/copyright.percona-proxy-mariadb; \
    cp /usr/share/common-licenses/GPL-2 /licenses/GPL-2.txt; \
    \
    # Hardening: no package manager caches, no manual pages, no documentation beyond the
    # copyright files, and no setuid or setgid binaries anywhere in the image.
    apt-get purge -y --auto-remove gnupg2; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /usr/share/man/* /usr/share/info/* /tmp/* /var/tmp/*; \
    find /usr/share/doc -type f ! -name copyright -delete; \
    find /usr/share/doc -type d -empty -delete; \
    find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} + || true

RUN set -ex; \
    install -o percona-proxy -g percona-proxy -m 0755 -d \
        /var/lib/percona-proxy /var/log/percona-proxy /var/cache/percona-proxy /run/percona-proxy \
        /var/lib/percona-proxy/percona-proxy.cnf.d

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY percona-proxy.cnf /etc/percona-proxy.cnf
RUN chmod +x /usr/local/bin/entrypoint.sh; \
    chown percona-proxy:percona-proxy /etc/percona-proxy.cnf

# readwritesplit, readconnroute and the REST API / GUI
EXPOSE 4006 4008 8989

VOLUME ["/var/lib/percona-proxy", "/var/log/percona-proxy"]

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD percona-proxyctl list servers > /dev/null || exit 1

USER percona-proxy
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["percona-proxy"]
