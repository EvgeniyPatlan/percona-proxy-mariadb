#!/usr/bin/make -f

export DH_VERBOSE = 1

# The bundled libmicrohttpd does not build with the link-time optimization that recent Ubuntu
# releases enable by default: it warns, and the build uses -Werror.
export DEB_BUILD_MAINT_OPTIONS = optimize=-lto

include /usr/share/dpkg/architecture.mk

EXTRA_CMAKE_FLAGS ?=

# The tarball has no .git directory; the commit ID travels in percona-build.properties.
PERCONA_PROXY_COMMIT := $(shell sed -n 's/^COMMIT=//p' percona-build.properties 2>/dev/null)

%:
	dh $@ --buildsystem=cmake --builddirectory=build

# Ubuntu's dpkg compresses the members with zstd by default. The reprepro that maintains
# repo.percona.com cannot read a zstd control.tar and rejects such packages, so build with
# xz, which every distribution and the repository tooling understand.
override_dh_builddeb:
	dh_builddeb -- -Zxz

override_dh_auto_configure:
	# debhelper sets FETCHCONTENT_FULLY_DISCONNECTED=ON, but the LDI filter downloads
	# libmarias3 with FetchContent at configure time.
	dh_auto_configure -- \
		-DFETCHCONTENT_FULLY_DISCONNECTED=OFF \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_COLOR_MAKEFILE=N \
		-DPACKAGE=Y \
		-DPACKAGE_NAME=percona-proxy-mariadb \
		-DTARGET_COMPONENT=core,devel \
		-DSKIP_CPACK=Y \
		-DBUILD_TESTS=N \
		-DPERCONA_PROXY_COMMIT=$(PERCONA_PROXY_COMMIT) \
		$(EXTRA_CMAKE_FLAGS)

# CMake installs etc/percona-proxy.cnf.template only when TARGET_COMPONENT is exactly "core",
# so debian/percona-proxy-mariadb.install takes it from the source tree instead.

# The modules live in a private directory and have no shlibs information.
override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/percona-proxy-mariadb/usr/lib/$(DEB_HOST_MULTIARCH)/percona-proxy \
		-- --ignore-missing-info

# The systemd unit and the init script are placed by the postinst script, as upstream does.
override_dh_installsystemd:

override_dh_installinit:

# percona-proxy-pam-auth-tool has to keep its setuid bit or PAM authentication fails;
# dh_fixperms removes setuid bits from everything by default.
override_dh_fixperms:
	dh_fixperms --exclude usr/bin/percona-proxy-pam-auth-tool

# Ship the binaries unstripped, like the RPM build.
override_dh_strip:

override_dh_dwz:

# The unit tests are not built in packaging builds.
override_dh_auto_test:
