# Percona Proxy with Valgrind
#
# This systemd service file runs Percona Proxy with Valgrind and differs from the
# real Percona Proxy service file mainly by the fact that it is a notify type
# service. The watchdog timeout is also set to a higher value to cope with the
# fact that valgrind makes things about ten times as slow as normal.
#
# The environment variables LOGNAME and HOST define the files that Valgrind used
# when it's interacting with vgdb. To connect to Percona Proxy while under Valgrind,
# define the LOGNAME and HOST environment variables to the same ones that are
# here.

[Unit]
Description=Percona Proxy for MariaDB Database Proxy
After=network.target

[Service]
Type=notify
Restart=on-abort
Environment=LOGNAME=percona-proxy
Environment=HOST=percona-proxy

# Make sure /var/cache/percona-proxy exists. Downgrading from 24.02 to 23.08 will
# remove it due to how the packaging has been changed.
ExecStartPre=+/usr/bin/install -d @PERCONA_PROXY_VARDIR@/cache/percona-proxy -o percona-proxy -g percona-proxy

# This makes sure /run/percona-proxy exists.
RuntimeDirectory=percona-proxy
PIDFile=/run/percona-proxy/percona-proxy.pid

# Use the default user and group
User=percona-proxy
Group=percona-proxy

StandardOutput=append:/var/log/percona-proxy/percona-proxy.log
StandardError=append:/var/log/percona-proxy/percona-proxy.log
ExecStart=/usr/bin/valgrind --num-callers=25 --keep-debuginfo=yes --track-origins=yes --exit-on-first-error=yes --error-exitcode=1 --error-markers=BEGIN_VALGRIND_ERROR,END_VALGRIND_ERROR @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_BINDIR@/percona-proxy -d -lstdout

TimeoutStartSec=120
LimitNOFILE=65535
StartLimitBurst=0
WatchdogSec=240s
NotifyAccess=all

# Percona Proxy should be restarted if it exits with 75 (BSD's EX_TEMPFAIL)
RestartForceExitStatus=75

[Install]
WantedBy=multi-user.target
