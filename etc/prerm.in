#!/bin/sh

# The first argument is the number of packages left after
# this one has been removed. If it is 0 then the package is being
# removed from the system.
if [ "$1" = "0" ] || [ "$1" = "remove" ]
then
    if [ -f /etc/init.d/percona-proxy ]
    then
        /etc/init.d/percona-proxy stop > /dev/null
        rm /etc/init.d/percona-proxy
    fi

    if [ -f /etc/ld.so.conf.d/percona-proxy.conf ]
    then
        rm /etc/ld.so.conf.d/percona-proxy.conf
    fi

    if [ -f /usr/lib/systemd/system/percona-proxy.service ]
    then
        systemctl stop percona-proxy.service > /dev/null
        systemctl disable percona-proxy.service > /dev/null 2>&1
        rm /usr/lib/systemd/system/percona-proxy.service
        systemctl daemon-reload > /dev/null
    elif [ -f /lib/systemd/system/percona-proxy.service ]
    then
        systemctl stop percona-proxy.service > /dev/null
        systemctl disable percona-proxy.service > /dev/null  2>&1
        rm /lib/systemd/system/percona-proxy.service
        systemctl daemon-reload > /dev/null
    fi

    if [ -f /etc/logrotate.d/percona-proxy-logrotate ]
    then
        rm /etc/logrotate.d/percona-proxy-logrotate
    fi
fi
