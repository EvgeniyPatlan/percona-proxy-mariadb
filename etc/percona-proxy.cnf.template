#################################################################################
# Percona Proxy for MariaDB documentation:                                      #
# https://github.com/EvgeniyPatlan/percona-proxy-mariadb/tree/main/Documentation#
#################################################################################

###############################################################################
# Global parameters                                                           #
#                                                                             #
# Complete list of configuration options:                                     #
# Documentation/Getting-Started/Configuration-Guide.md                        #
###############################################################################
[percona-proxy]
threads=auto

############################################################################
# Server definitions                                                       #
#                                                                          #
# Set the address of the server to the network address of a MariaDB server.#
############################################################################

[server1]
type=server
address=127.0.0.1
port=3306
######################################################################################
# Uncomment this and add Percona Proxy's IP to proxy_protocol_networks in MariaDB for#
# easier user management: https://mariadb.com/kb/en/proxy-protocol-support/          #
######################################################################################
# proxy_protocol=true

####################################################################################
# Monitor for the servers                                                          #
#                                                                                  #
# This will keep Percona Proxy aware of the state of the servers.                  #
# MariaDB Monitor documentation:                                                   #
# Documentation/Monitors/Monitor-Common.md                                         #
#                                                                                  #
# The GRANTs needed by the monitor user depend on the actual monitor.              #
# The GRANTs required by the MariaDB Monitor can be found here:                    #
# Documentation/Monitors/MariaDB-Monitor.md#required-grants                        #
####################################################################################

[MariaDB-Monitor]
type=monitor
module=mariadbmon
servers=server1
user=monitor_user
password=monitor_pw
monitor_interval=2s
####################################################################################################
# Uncomment these to enable automatic node failover:                                               #
# Documentation/Monitors/MariaDB-Monitor.md#cluster-manipulation-operations                        #
#                                                                                                  #
# The GRANTs required for automatic node failover can be found here:                               #
# Documentation/Monitors/MariaDB-Monitor.md#cluster-manipulation-grants                            #
####################################################################################################
# auto_failover=true
# auto_rejoin=true
# enforce_simple_topology=true
# replication_user=<username used for replication>
# replication_password=<password used for replication>
#################################################################################################
# Uncomment this if you use more than one Percona Proxy with automatic node failover:           #
# Documentation/Monitors/MariaDB-Monitor.md#cooperative-monitoring                              #
#################################################################################################
# cooperative_monitoring_locks=majority_of_all

###########################################################################################
# Service definitions                                                                     #
#                                                                                         #
# Service Definition for a read-only service and a read/write splitting service.          #
#                                                                                         #
# The GRANTs needed by the service user can be found here:                                #
# Documentation/Authenticators/Authentication-Modules.md#required-grants                  #
###########################################################################################

##################################################################
# ReadConnRoute documentation:                                   #
# Documentation/Routers/ReadConnRoute.md                         #
##################################################################

[Read-Only-Service]
type=service
router=readconnroute
servers=server1
user=service_user
password=service_pw
router_options=slave

###################################################################
# ReadWriteSplit documentation:                                   #
# Documentation/Routers/ReadWriteSplit.md                         #
###################################################################

[Read-Write-Service]
type=service
router=readwritesplit
servers=server1
user=service_user
password=service_pw
######################################################################################
# Uncomment these to enable transparent transaction replay on node failure:          #
# Documentation/Routers/ReadWriteSplit.md#transaction_replay                         #
######################################################################################
# transaction_replay=true
# transaction_replay_timeout=30s

####################################################################
# Listener definitions for the services                            #
#                                                                  #
# These listeners represent the ports the services will listen on. #
####################################################################

[Read-Only-Listener]
type=listener
service=Read-Only-Service
port=4008

[Read-Write-Listener]
type=listener
service=Read-Write-Service
port=4006
