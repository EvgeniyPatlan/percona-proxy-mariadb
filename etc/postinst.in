#!/bin/sh

# Create directories
mkdir -p @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_LIBDIR@
mkdir -p @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_BINDIR@
mkdir -p @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@
mkdir -p @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_DOCDIR@

# PERCONA_PROXY_VARDIR is an absolute path to /var by default
mkdir -p @PERCONA_PROXY_VARDIR@/log/percona-proxy
mkdir -p @PERCONA_PROXY_VARDIR@/lib/percona-proxy
mkdir -p @PERCONA_PROXY_VARDIR@/cache/percona-proxy
mkdir -p @PERCONA_PROXY_VARDIR@/run/percona-proxy

# Create Percona Proxy user if it doesnt' exist
if ! getent passwd percona-proxy > /dev/null
then
    groupadd -r percona-proxy
    useradd -r -s /bin/false -g percona-proxy percona-proxy
fi

# Change the owner of the directories to percona-proxy:percona-proxy
chown -R percona-proxy:percona-proxy @PERCONA_PROXY_VARDIR@/log/percona-proxy
chown -R percona-proxy:percona-proxy @PERCONA_PROXY_VARDIR@/lib/percona-proxy
chown -R percona-proxy:percona-proxy @PERCONA_PROXY_VARDIR@/cache/percona-proxy
chown -R percona-proxy:percona-proxy @PERCONA_PROXY_VARDIR@/run/percona-proxy
chmod 0755 @PERCONA_PROXY_VARDIR@/log/percona-proxy
chmod 0755 @PERCONA_PROXY_VARDIR@/lib/percona-proxy
chmod 0755 @PERCONA_PROXY_VARDIR@/cache/percona-proxy
chmod 0755 @PERCONA_PROXY_VARDIR@/run/percona-proxy

# Create the module configuration directory (default: /etc/percona-proxy.modules.d/)
mkdir -p @DEFAULT_MODULE_CONFIGDIR@

# Install ldconfig files
if [ -f "@CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/percona-proxy.conf" ]
then
    cp @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/percona-proxy.conf /etc/ld.so.conf.d/
else
    echo "Could not find ldconfig file: @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/percona-proxy.conf" >& 2
fi

# Only copy the service files if the systemd folder and systemctl executable are found
if [ -f @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/percona-proxy.service ] && command -v systemctl > /dev/null
then
    if [ -d "/lib/systemd/system"  ]
    then
        cp @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/percona-proxy.service /lib/systemd/system
        systemctl daemon-reload > /dev/null 2>&1
    elif [ -d "/usr/lib/systemd/system"  ]
    then
        cp @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/percona-proxy.service /usr/lib/systemd/system
        systemctl daemon-reload > /dev/null 2>&1
    fi

    # Remove old directories, mistakenly installed by a few versions
    if [ -d /lib/systemd/system/percona-proxy.service.d ]
    then
        rmdir /lib/systemd/system/percona-proxy.service.d
    elif  [ -d /usr/lib/systemd/system/percona-proxy.service.d ]
    then
        rmdir /lib/systemd/system/percona-proxy.service.d
    fi

    mkdir -p /etc/systemd/system/percona-proxy.service.d
    systemctl enable percona-proxy.service > /dev/null 2>&1

    systemctl is-active percona-proxy.service --quiet > /dev/null 2&>1 && systemctl restart percona-proxy.service > /dev/null 2>&1
else
    if [ -d "/etc/init/" ] && [ -f "@CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/upstart/percona-proxy.conf" ]
    then
        cp @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/upstart/percona-proxy.conf /etc/init/
    fi

    # If systemd is not present, use init.d scripts if they're present
    if [ -d "/etc/init.d/" ] && [ -f "@CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/percona-proxy" ]
    then
        cp @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/percona-proxy /etc/init.d/
    fi

    service percona-proxy status > /dev/null 2>&1 && service percona-proxy restart > /dev/null
fi

# If no percona-proxy.cnf file is found in /etc, copy the template file there
if [ ! -f "@PERCONA_PROXY_CONFDIR@/percona-proxy.cnf" ]
then
    cp @PERCONA_PROXY_CONFDIR@/percona-proxy.cnf.template @PERCONA_PROXY_CONFDIR@/percona-proxy.cnf
    mkdir -p @PERCONA_PROXY_CONFDIR@/percona-proxy.cnf.d/
fi

# If no logrotate config file is found, create one
if [ ! -f "/etc/logrotate.d/percona-proxy-logrotate" ]
then
    cp @CMAKE_INSTALL_PREFIX@/@PERCONA_PROXY_SHAREDIR@/percona-proxy-logrotate /etc/logrotate.d/percona-proxy-logrotate
fi

/sbin/ldconfig
